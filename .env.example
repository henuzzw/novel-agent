DB_HOST=localhost
DB_PORT=5432
DB_NAME=novel_agent
DB_USERNAME=novel_app
DB_PASSWORD=change-me
DB_SCHEMA=novel_agent
DB_SSL_MODE=disable

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_CONNECTION_TIMEOUT=5s
NEO4J_DATABASE=neo4j

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=kafka
KAFKA_PASSWORD=change-me
KAFKA_CANON_TOPIC=novel.canon.committed.v1

APP_DEV_USER_ID=00000000-0000-0000-0000-000000000001
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080

CODEX_CLI_COMMAND=codex.exe
CODEX_LOG_LEVEL=INFO
LOG_FILE=logs/novel-agent-server.log
CODEX_MODEL=gpt-6-sol
CODEX_CLI_TIMEOUT_SECONDS=600
CODEX_RUNTIME_DIRECTORY=tmp/codex-runtime
# 首次启动时从此位置引导登录凭据，之后使用独立的 CODEX_HOME。
CODEX_AUTH_SOURCE=C:/Users/your-name/.codex/auth.json
# 可选：仅让 Codex App Server 走 Clash，不影响数据库、Neo4j 和 Kafka。
CODEX_PROXY_URL=http://127.0.0.1:7897

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0
CODEX_INPUT_PRICE_PER_MILLION=0
CODEX_OUTPUT_PRICE_PER_MILLION=0

# Model context planning
CODEX_CONTEXT_WINDOW_TOKENS=128000
CODEX_CONTEXT_SAFETY_MARGIN_TOKENS=4000
DEEPSEEK_CONTEXT_WINDOW_TOKENS=64000
DEEPSEEK_CONTEXT_SAFETY_MARGIN_TOKENS=4000
LOCAL_TEMPLATE_CONTEXT_WINDOW_TOKENS=32000
LOCAL_TEMPLATE_CONTEXT_SAFETY_MARGIN_TOKENS=2000

IMPORT_MAX_FILE_BYTES=20971520

# Semantic embedding: local or remote (OpenAI-compatible /embeddings)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Stage-specific long-term memory budgets
MEMORY_CONTRACT_DESIRED_TOKENS=5000
MEMORY_CONTRACT_MINIMUM_TOKENS=2500
MEMORY_CONTRACT_RESERVED_OUTPUT_TOKENS=3000
MEMORY_CONTRACT_MAX_SEMANTIC_MEMORIES=5
MEMORY_CONTRACT_MAX_GRAPH_FACTS=12

MEMORY_MANUSCRIPT_DESIRED_TOKENS=8000
MEMORY_MANUSCRIPT_MINIMUM_TOKENS=4000
MEMORY_MANUSCRIPT_RESERVED_OUTPUT_TOKENS=10000
MEMORY_MANUSCRIPT_MAX_SEMANTIC_MEMORIES=8
MEMORY_MANUSCRIPT_MAX_GRAPH_FACTS=20

MEMORY_REVIEW_DESIRED_TOKENS=6000
MEMORY_REVIEW_MINIMUM_TOKENS=3000
MEMORY_REVIEW_RESERVED_OUTPUT_TOKENS=5000
MEMORY_REVIEW_MAX_SEMANTIC_MEMORIES=6
MEMORY_REVIEW_MAX_GRAPH_FACTS=16
